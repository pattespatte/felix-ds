{
  "name": "@pattespatte/felix-ds",
  "version": "1.2.0",
  "type": "module",
  "description": "A thin, organisation-neutral theme layer (CSS custom properties + self-hosted fonts) on top of FKUI's public npm packages.",
  "main": "./dist/felix.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pattespatte/felix-ds.git"
  },
  "bugs": {
    "url": "https://github.com/pattespatte/felix-ds/issues"
  },
  "homepage": "https://pattespatte.github.io/felix-ds/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build --config playground/vite.config.ts",
    "build:theme": "bun scripts/build-css.ts",
    "fkui": "bun scripts/fkui.ts",
    "icons:build": "bun scripts/icons.ts",
    "tokens:build": "bun scripts/tokens.ts",
    "changelog": "bunx git-cliff -o CHANGELOG.md",
    "test:visual": "playwright test --project=chromium",
    "test:visual:update": "playwright test --project=chromium --update-snapshots",
    "test:visual:cross": "playwright test visual-cross.spec.ts --project=webkit && playwright test visual-cross.spec.ts --project=firefox",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=chromium"
  },
  "sass": "./src/index.scss",
  "files": [
    "dist",
    "src",
    "tokens",
    "README.md"
  ],
  "sideEffects": [
    "./dist/**/*.css",
    "./src/**/*.scss"
  ],
  "peerDependencies": {
    "@fkui/theme-default": ">=6.57.0 <7.0.0"
  },
  "devDependencies": {
    "@fkui/date": "6.62.0",
    "@fkui/design": "6.62.0",
    "@fkui/icon-lib-default": "6.62.0",
    "@fkui/logic": "6.62.0",
    "@fkui/theme-default": "6.62.0",
    "@fkui/vue": "6.62.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "axe-playwright": "^2.2.2",
    "playwright": "^1.63.0",
    "sass": "^1.104.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.11"
  }
}
