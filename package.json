{
  "name": "felix-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private proof of concept: a thin theme layer (CSS custom properties + self-hosted fonts) on top of FKUI's public npm packages.",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build --config playground/vite.config.ts",
    "build:theme": "sass --load-path=node_modules src/index.scss dist/felix.css && cp -R src/fonts/files dist/files",
    "fkui": "bun scripts/fkui.ts"
  },
  "sass": "./src/index.scss",
  "dependencies": {
    "@fkui/date": "6.57.1",
    "@fkui/design": "6.57.1",
    "@fkui/icon-lib-default": "6.57.1",
    "@fkui/logic": "6.57.1",
    "@fkui/theme-default": "6.57.1",
    "@fkui/vue": "6.57.1",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.104.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
